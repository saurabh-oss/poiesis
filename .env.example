# ---- LLM routing -----------------------------------------------------------
# local  = Ollama on your GPU (no data leaves the laptop)
# groq   = fast free-tier hosted, good for iterating on the graph
# cloud  = Anthropic for the reasoning-heavy agents, local for the rest
POIESIS_LLM_PROFILE=local

# Native Ollama on the Windows host. Requires OLLAMA_HOST=0.0.0.0:11434 there.
OLLAMA_BASE_URL=http://host.docker.internal:11434
POIESIS_MODEL_REASONING=ollama/poiesis-reasoning
POIESIS_MODEL_CODING=ollama/poiesis-coding
POIESIS_MODEL_FAST=ollama/poiesis-fast
POIESIS_MODEL_EMBED=ollama/nomic-embed-text

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ---- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://poiesis:poiesis@postgres:5432/poiesis
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=poiesisdev
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=poiesis
MINIO_SECRET_KEY=poiesisdev

# ---- Policy ----------------------------------------------------------------
POIESIS_PACK=packs/default.yaml
POIESIS_WORKSPACE_ROOT=/workspaces
POIESIS_MAX_SPRINT_STORIES=6

# Where ./workspaces lives as the HOST Docker daemon sees it.
# Generated code runs in sibling containers launched through the mounted docker
# socket, so the daemon resolves the bind mount on the host, not inside the
# orchestrator. Get this wrong and the sandbox mounts an empty directory, pytest
# collects nothing, and every story burns its repair attempts on invisible code.
# Windows: the absolute path to this repo's workspaces folder.
POIESIS_WORKSPACE_HOST_ROOT=C:/code/poiesis/workspaces

# ---- Deployments -----------------------------------------------------------
# Each generated application gets a port from this range on the Docker host.
POIESIS_DEPLOY_PORT_START=8100
POIESIS_DEPLOY_PORT_END=8199
# The address people type to open an app.
POIESIS_DEPLOY_PUBLIC_HOST=localhost
# Host interface apps bind to. 127.0.0.1 keeps unauthenticated generated code off
# your network; widen it only once access control exists.
POIESIS_DEPLOY_BIND=127.0.0.1
