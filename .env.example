# ---- LLM routing -----------------------------------------------------------
# local  = Ollama on your GPU (no data leaves the laptop)
# groq   = fast free-tier hosted, good for iterating on the graph
# cloud  = Anthropic for the reasoning-heavy agents, local for the rest
POIESIS_LLM_PROFILE=local

# Native Ollama on the Windows host. Requires OLLAMA_HOST=0.0.0.0:11434 there.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Qwen3.6 35B-A3B: a mixture-of-experts model (3B active) that runs well split
# across a 12 GB GPU and system RAM, with a 256K context. The -coding variant
# writes the files; the general one reasons, plans and reviews.
POIESIS_MODEL_REASONING=ollama/qwen3.6:35b-a3b
POIESIS_MODEL_CODING=ollama/qwen3.6:35b-a3b-coding
POIESIS_MODEL_FAST=ollama/qwen3.6:35b-a3b
POIESIS_MODEL_EMBED=ollama/nomic-embed-text
# Reads whiteboard photos and diagrams handed in as evidence.
POIESIS_MODEL_VISION=ollama/gemma4:12b
# The context window sent with every request, and which roles may think first.
POIESIS_LOCAL_NUM_CTX=32768
POIESIS_LOCAL_THINK_ROLES=reasoning
# Prompt tokens per GPU batch. Small keeps every kernel inside Windows' GPU
# timeout on a throttling laptop (a VIDEO_TDR_FAILURE bugcheck otherwise).
POIESIS_LOCAL_NUM_BATCH=128

GROQ_API_KEY=
ANTHROPIC_API_KEY=

# ---- Infrastructure --------------------------------------------------------
DATABASE_URL=postgresql+psycopg://poiesis:poiesis@postgres:5432/poiesis
REDIS_URL=redis://redis:6379/0
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=poiesisdev
QDRANT_URL=http://qdrant:6333
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=poiesis
MINIO_SECRET_KEY=poiesisdev

# ---- Policy ----------------------------------------------------------------
POIESIS_PACK=packs/default.yaml
POIESIS_WORKSPACE_ROOT=/workspaces
POIESIS_MAX_SPRINT_STORIES=6

# Where ./workspaces lives as the HOST Docker daemon sees it.
# Generated code runs in sibling containers launched through the mounted docker
# socket, so the daemon resolves the bind mount on the host, not inside the
# orchestrator. Get this wrong and the sandbox mounts an empty directory, pytest
# collects nothing, and every story burns its repair attempts on invisible code.
# Windows: the absolute path to this repo's workspaces folder.
POIESIS_WORKSPACE_HOST_ROOT=C:/code/poiesis/workspaces

# ---- Deployments -----------------------------------------------------------
# Each generated application gets a port from this range on the Docker host.
POIESIS_DEPLOY_PORT_START=8100
POIESIS_DEPLOY_PORT_END=8199
# The address people type to open an app.
POIESIS_DEPLOY_PUBLIC_HOST=localhost
# Host interface apps bind to. 127.0.0.1 keeps unauthenticated generated code off
# your network; widen it only once access control exists.
POIESIS_DEPLOY_BIND=127.0.0.1

# --- Jira Cloud (optional) ---------------------------------------------------
# When all four are set, every run is mirrored into this project: the run becomes
# an Initiative, the backlog its Epics and Stories, the sprint a started Jira
# sprint, and stories move to In Progress / Done as they are built. A Jira outage
# or bad token never stops a run. Verify with:
#   docker compose exec orchestrator python -m app.integrations.jira check
JIRA_BASE_URL=
JIRA_EMAIL=
# id.atlassian.com > Security > Create and manage API tokens
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
# The issue type a run becomes. Needs Jira Premium with the hierarchy configured;
# without it, epics are created with no parent.
JIRA_INITIATIVE_TYPE=Initiative
# 0 = the project's first scrum board
JIRA_BOARD_ID=0
JIRA_SPRINT_DAYS=14

# ---- Engine -----------------------------------------------------------------
# Runs beyond this wait in a queue. One GPU serves one run well and two badly.
POIESIS_MAX_CONCURRENT_RUNS=1
# Bring released apps back after a restart (each is a compose project).
POIESIS_RESTART_DEPLOYMENTS_ON_BOOT=true

# ---- Observability ----------------------------------------------------------
# Spans and every model call are stored in Postgres regardless. Set an OTLP
# endpoint to also export traces (Jaeger from compose: http://localhost:16686).
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
# text | json (json for a log shipper)
POIESIS_LOG_FORMAT=text
# Semantic recall over the portfolio and past runs (Qdrant). Costs nothing when off.
POIESIS_VECTORS=true

# --- Git remote (optional) ---------------------------------------------------
# Every run's workspace is pushed as it is built: branch run/<id>, a tag at
# release, and on GitHub a pull request into the default branch (or the default
# branch itself for a repository created by the run). {slug} is the product
# name; {run_id} and {short} are also available.
GIT_REMOTE_TEMPLATE=
# e.g. GIT_REMOTE_TEMPLATE=https://github.com/acme/poiesis-{slug}.git
GIT_TOKEN=
GIT_USERNAME=x-access-token
GIT_DEFAULT_BRANCH=main
GIT_PUSH_EACH_STORY=true
# GitHub only: create missing repositories under this user or organisation.
GITHUB_OWNER=
GITHUB_PRIVATE=true
GIT_OPEN_PULL_REQUEST=true
