# Copy to plane.env and replace the two secret keys (openssl rand -hex 32).
# PLANE_ADMIN_PASSWORD left empty: plane-bootstrap.py generates one and writes it back.
# Plane, the self-hosted tracker Poiesis mirrors every run into.
# Its own compose project so it starts and stops independently of the platform:
#   docker compose -f infra/plane/docker-compose.yml --env-file infra/plane/plane.env -p plane up -d
# Web UI: http://localhost:8200  (the bootstrap script prints the sign-in)
APP_DOMAIN=localhost
APP_RELEASE=v1.4.2
WEB_URL=http://localhost:8200
CORS_ALLOWED_ORIGINS=http://localhost:8200,http://localhost:3000
LISTEN_HTTP_PORT=8200
LISTEN_HTTPS_PORT=8443
SITE_ADDRESS=:80
TRUSTED_PROXIES=0.0.0.0/0
DEBUG=0
API_BASE_URL=http://api:8000
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
PGDATABASE=plane
USE_MINIO=1
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads
FILE_SIZE_LIMIT=5242880
# Mirroring every past run at once is thousands of calls; the default 60/minute throttles it.
API_KEY_RATE_LIMIT=6000/minute
SECRET_KEY=change-me-run-openssl-rand-hex-32
LIVE_SERVER_SECRET_KEY=change-me-run-openssl-rand-hex-32
# Caddy refuses its config with an empty ACME directory, even when serving plain HTTP.
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL=
CERT_ACME_DNS=
PLANE_ADMIN_EMAIL=admin@poiesis.local
PLANE_ADMIN_PASSWORD=
